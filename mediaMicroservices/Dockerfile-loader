FROM ubuntu:20.04 AS builder

# Install build dependencies
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        build-essential \
        ca-certificates \
        libsasl2-2 \
        libssl-dev \
        openssl \
        zlib1g-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy wrk2 sources and build 
COPY ./wrk2 /media-microservices/wrk2

RUN cd /media-microservices/wrk2 \
    && make -j$(nproc) \
    && make install

FROM ubuntu:20.04

# Copy compiled binaries and wrk2/scripts
COPY --from=builder /usr/local/bin/* /usr/local/bin/
COPY ./wrk2/scripts /media-microservices/wrk2/scripts

# Install system dependencies
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        ca-certificates \
        libsasl2-2 \
        lua-socket \
        netcat \
        openssl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV LUA_PATH="/usr/share/lua/5.1/?.lua;/usr/share/lua/5.1/?;?.lua;?"
ENV LUA_CPATH="/usr/lib/x86_64-linux-gnu/lua/5.1/?.so;?.so"

WORKDIR /media-microservices
