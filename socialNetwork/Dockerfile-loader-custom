# Dockerfile for load generator using custom pre-built wrk2 binary
# Use this when you have a custom wrk2 binary with continuous mode support
#
# Build instructions:
# 1. Build your custom wrk2 binary (see CUSTOM_WRK2.md)
# 2. Place the binary at ./wrk2-custom/wrk
# 3. Build: docker build -f Dockerfile-loader-custom -t social-loader:custom .

FROM ubuntu:20.04

# Copy pre-built custom wrk2 binary
# Expects wrk2-custom/wrk to exist in the build context
COPY ./wrk2-custom/wrk /usr/local/bin/wrk

# Copy datasets and scripts
COPY ./datasets /social-network-microservices/datasets/
COPY ./scripts /social-network-microservices/scripts/
COPY ./wrk2/scripts /social-network-microservices/wrk2/scripts

# Install system dependencies
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        ca-certificates \
        libsasl2-2 \
        lua-socket \
        netcat \
        openssl \
        python3-aiohttp \
        python3-minimal \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV LUA_PATH="/usr/share/lua/5.1/?.lua;/usr/share/lua/5.1/?;?.lua;?"
ENV LUA_CPATH="/usr/lib/x86_64-linux-gnu/lua/5.1/?.so;?.so"

WORKDIR /social-network-microservices

# Make wrk executable
RUN chmod +x /usr/local/bin/wrk
